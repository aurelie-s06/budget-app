<!DOCTYPE html>
<html lang="fr" data-theme="{{ request.plainCookie('app_theme', { defaultValue: 'light', encoded: false }) }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Mon Budget : suis tes comptes, tes dépenses, tes budgets par catégorie et ton épargne, au même endroit."
    />
    <title data-inertia>
      Mon Budget
    </title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />

    {{-- Application installable : Safari > Fichier > Ajouter au Dock --}}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="Mon Budget" />
    <meta name="apple-mobile-web-app-title" content="Mon Budget" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="theme-color"
      content="{{ request.plainCookie('app_theme', { defaultValue: 'light', encoded: false }) === 'dark' ? '#111114' : '#ffffff' }}"
    />

    {{-- Dans le layout : masqués même avant le chargement de la feuille de styles --}}
    <style>
      .b-skip { margin: 0; padding: 0; list-style: none; }
      .b-skip a:not(:focus) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>

    @viteReactRefresh({ nonce: cspNonce })
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
